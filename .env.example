# ══ Django ═══════════════════════════════════════════════════════════════════
DJANGO_SECRET_KEY=doi-chuoi-nay-khi-trien-khai
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Thêm khi chạy sau HTTPS, ví dụ: DJANGO_CSRF_ORIGINS=https://bvtv.example.gov.vn
DJANGO_CSRF_ORIGINS=

# ══ Cơ sở dữ liệu ════════════════════════════════════════════════════════════
DB_ENGINE=postgres
DB_NAME=pest_survey
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ══ Chạy thực tế (serve.py / waitress) ═══════════════════════════════════════
SERVE_HOST=127.0.0.1
SERVE_PORT=8000
SERVE_THREADS=8

# ══ Bảo mật — chỉ áp dụng khi DJANGO_DEBUG=0 ══════════════════════════════════
# Cookie phiên chỉ gửi qua HTTPS. BẬT (1) nếu có HTTPS — đây là cấu hình đúng.
# Nếu mạng nội bộ KHÔNG có HTTPS, phải đặt 0, nếu không KHÔNG AI ĐĂNG NHẬP ĐƯỢC.
DJANGO_SECURE_COOKIES=1
# Bật khi đã có HTTPS chạy ổn định. Bật sớm sẽ khoá người dùng ra ngoài.
DJANGO_SSL_REDIRECT=0
# Đặt 31536000 (1 năm) sau khi HTTPS đã chạy ổn định ít nhất vài tuần.
DJANGO_HSTS_SECONDS=0
# Đặt 1 nếu chạy sau nginx/IIS có TLS.
DJANGO_BEHIND_PROXY=0

# Số lần đăng nhập sai liên tiếp trước khi tạm khoá, và thời gian khoá (giây)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ══ Ghi log ══════════════════════════════════════════════════════════════════
DJANGO_LOG_LEVEL=INFO

# ══ Email — cần cho chức năng phát hành cảnh báo qua email ════════════════════
# Bỏ trống thì email chỉ in ra console (dùng khi thử nghiệm).
# EMAIL_HOST=smtp.example.gov.vn
# EMAIL_PORT=587
# EMAIL_USER=canhbao@example.gov.vn
# EMAIL_PASSWORD=mat_khau
# DEFAULT_FROM_EMAIL=canhbao@example.gov.vn

# ══ Tác vụ nền (email, SMS) ══════════════════════════════════════════════════
# thread (mặc định): chạy ngay trong luồng nền | worker: chạy `python manage.py process_tasks --loop`
# Tác vụ lỗi được thử lại tối đa 3 lần; `run_schedules` cũng chạy lại tác vụ đến hạn.
TASKS_MODE=thread

# ══ SMS qua eSMS.vn — bỏ trống khoá thì chỉ ghi log, không gửi thật ═══════════
# ESMS_API_KEY=
# ESMS_SECRET_KEY=
# ESMS_SMS_TYPE=8
# ESMS_BRANDNAME=

# ══ Đăng nhập LDAP / Active Directory — bỏ trống LDAP_SERVER_URI thì tắt ══════
# LDAP_SERVER_URI=ldaps://dc.example.gov.vn:636
# LDAP_USER_DN_TEMPLATE={username}@example.gov.vn
# LDAP_SEARCH_BASE=dc=example,dc=gov,dc=vn
# LDAP_DEFAULT_ROLE=viewer
# LDAP_AUTO_CREATE=1

# ══ Trợ lý AI hội thoại (tùy chọn, API tương thích OpenAI) ════════════════════
# Bỏ trống thì dùng trợ lý trích rút offline.
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=

# ══ Công cụ ngoài ════════════════════════════════════════════════════════════
# Thư mục bin của PostgreSQL (để sao lưu/khôi phục bằng pg_dump / pg_restore)
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
# Font Unicode để xuất PDF tiếng Việt
# PDF_FONT_PATH=C:\Windows\Fonts\arial.ttf
