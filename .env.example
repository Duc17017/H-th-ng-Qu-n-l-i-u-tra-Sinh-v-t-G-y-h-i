# ══ Django ═══════════════════════════════════════════════════════════════════
DJANGO_SECRET_KEY=doi-chuoi-nay-khi-trien-khai
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Thêm khi chạy sau HTTPS, ví dụ: DJANGO_CSRF_ORIGINS=https://bvtv.example.gov.vn
DJANGO_CSRF_ORIGINS=

# ══ Cơ sở dữ liệu ════════════════════════════════════════════════════════════
DB_ENGINE=postgres
DB_NAME=pest_survey
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ══ Chạy thực tế (serve.py / waitress) ═══════════════════════════════════════
SERVE_HOST=127.0.0.1
SERVE_PORT=8000
SERVE_THREADS=8

# ══ Bảo mật — chỉ áp dụng khi DJANGO_DEBUG=0 ══════════════════════════════════
# Bật khi đã có HTTPS chạy ổn định. Bật sớm sẽ khoá người dùng ra ngoài.
DJANGO_SSL_REDIRECT=0
# Đặt 31536000 (1 năm) sau khi HTTPS đã chạy ổn định ít nhất vài tuần.
DJANGO_HSTS_SECONDS=0
# Đặt 1 nếu chạy sau nginx/IIS có TLS.
DJANGO_BEHIND_PROXY=0

# Số lần đăng nhập sai liên tiếp trước khi tạm khoá, và thời gian khoá (giây)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ══ Ghi log ══════════════════════════════════════════════════════════════════
DJANGO_LOG_LEVEL=INFO

# ══ Email — cần cho chức năng phát hành cảnh báo qua email ════════════════════
# Bỏ trống thì email chỉ in ra console (dùng khi thử nghiệm).
# EMAIL_HOST=smtp.example.gov.vn
# EMAIL_PORT=587
# EMAIL_USER=canhbao@example.gov.vn
# EMAIL_PASSWORD=mat_khau
# DEFAULT_FROM_EMAIL=canhbao@example.gov.vn

# ══ Công cụ ngoài ════════════════════════════════════════════════════════════
# Thư mục bin của PostgreSQL (để sao lưu/khôi phục bằng pg_dump / pg_restore)
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
# Font Unicode để xuất PDF tiếng Việt
# PDF_FONT_PATH=C:\Windows\Fonts\arial.ttf
